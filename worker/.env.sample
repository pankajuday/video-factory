DEV_ENV=local # this env specifies the development environment is local or production

MONGO_URI_W=mongodb://127.0.0.1:27017
PORT=3000



# REDIES CONFIGURATION
REDIS_PORT=6379
REDIS_URI=localhost

# S3-compatible object storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=<s3_access_key>
S3_SECRET_KEY=<s3_secret_key>
S3_REGION=us-east-1
S3_BUCKET=video-factory

